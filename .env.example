# النطاق الذي سيعمل عليه الموقع (مثل darb.example.com) — يوجَّه سجل A إلى عنوان الخادم
DARB_DOMAIN=localhost
# المناطق المفعّلة معًا: singapore (LTA) و phoenix (ADOT)
DARB_REGIONS=singapore,phoenix,tucson,yuma,tampa
DATAGOVSG_API_KEY=
# جدول الالتقاط (بالتوقيت المحلي لكل منطقة)
DARB_WEEKLY_DAY=mon
DARB_WEEKLY_HOUR=10
DARB_SENTINEL_HOURS=24
# رمز المشرف لحماية الإضافة والالتقاط اليدوي وتسجيل الصيانة — إلزامي عند النشر العام (نص عشوائي طويل)
DARB_ADMIN_TOKEN=
# Dubai Pulse — حوادث المرور (اختياري، عند إضافة منطقة دبي بكاميرات مرخّصة)
DUBAI_PULSE_API_KEY=
DUBAI_PULSE_API_SECRET=
# نماذج الذكاء الاصطناعي (افتراضيًا كل ملفات models/*.pt — نزّلها بـ python -m backend.models)
DARB_YOLO_MODELS=
# إرسال التنبيهات إلى Slack/Teams/نظام بلاغات (اختياري)
DARB_ALERT_WEBHOOK=
# عدد أسابيع السجل التجريبي للكاميرات المحاكاة عند أول تشغيل
DARB_SEED_WEEKS=26
